
# Copy this file to .env and fill in the values before running `docker compose up`.
# Do NOT commit .env to version control — it contains secrets.
#
# Values managed automatically by docker-compose (do NOT set them here):
#   POSTGRES_HOST, POSTGRES_PORT, QDRANT_URL, MCP_SERVER_URL, APP_SERVER_PORT

# ── Azure OpenAI (required) ───────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI — Embeddings
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── LangSmith observability (optional) ───────────────────────────────────────
# Leave LANGSMITH_API_KEY blank to disable tracing.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ecommerce-ops-agent

# ── Qdrant ────────────────────────────────────────────────────────────────────
# QDRANT_URL is set to http://qdrant:6333 by docker-compose; do not set it here.
# Set QDRANT_API_KEY only if your Qdrant instance requires authentication.
# QDRANT_API_KEY=
QDRANT_COLLECTION=incident_memory

# ── PostgreSQL credentials ────────────────────────────────────────────────────
# POSTGRES_HOST, POSTGRES_PORT, and DATABASE_URL are managed by docker-compose.
POSTGRES_DB=ops_agent
POSTGRES_USER=ops_user
POSTGRES_PASSWORD=ops_password

# ── LangGraph checkpoint backend ─────────────────────────────────────────────
# "postgres" is recommended in Docker so checkpoints survive container restarts.
CHECKPOINT_BACKEND=postgres

# ── Agent tuning (optional — these already have sensible defaults) ────────────
# REFLECTION_CONFIDENCE_THRESHOLD=0.4
# MAX_REFLECTION_RETRIES=2
# SPECIALIST_TIMEOUT_SECONDS=30
# HITL_TIMEOUT_SECONDS=300